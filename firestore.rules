rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------
    // helpers
    // -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // -----------------------------------------------------------
    // users/{uid}
    // 本人のみ読み書き可
    // -----------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isAdmin();
    }

    // -----------------------------------------------------------
    // results/{resultId}
    // 本人のみ読み書き可
    // 集計クエリは Cloud Functions（管理者権限）経由のみ
    // -----------------------------------------------------------
    match /results/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // -----------------------------------------------------------
    // questions/{questionId}
    // 全員読み取り可、書き込みは管理者のみ
    // -----------------------------------------------------------
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------
    // relationships/{relId}
    // 両者が consent している場合のみ閲覧可（Phase 5）
    // -----------------------------------------------------------
    match /relationships/{relId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.viewedBy;
      allow create, update: if isSignedIn() &&
        (request.auth.uid == request.resource.data.userIdA ||
         request.auth.uid == request.resource.data.userIdB);
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------
    // analytics_aggregates/{periodId}
    // 管理者のみ
    // -----------------------------------------------------------
    match /analytics_aggregates/{periodId} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------
    // content_published/{type}/items/{id}
    // 誰でも読める、書き込みは admin のみ
    // -----------------------------------------------------------
    match /content_published/{type}/items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------
    // content_history/{type}/{id}/{historyId}
    // admin のみ読み書き
    // -----------------------------------------------------------
    match /content_history/{type}/{id}/{historyId} {
      allow read, write: if isAdmin();
    }

    // -----------------------------------------------------------
    // 上記以外は全拒否
    // -----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
